# AEE
ro.vendor.have_aee_feature=1

# Audio
ro.camera.sound.forced=0
ro.audio.silent=0
ro.audio.usb.period_us=16000
ro.config.vc_call_vol_steps=7

# Brand
Build.BRAND=MTK

# Camera
oplus.camera.packname=com.oplus.camera
oplus.camera.activityname=com.oplus.camera
ro.oplus.system.camera.name=com.oplus.camera

# Charger
ro.charger.enable_suspend=true

# Display
ro.opengles.version=196610

# Dalvik
dalvik.vm.dex2oat64.enabled=true

# RIL
vendor.rild.libpath=mtk-ril.so
vendor.rild.libargs=-d /dev/ttyC0
ro.vendor.mtk_telephony_add_on_policy=0
ro.telephony.sim.count=2

# Perf
ro.mtk_perf_simple_start_win=1
ro.mtk_perf_fast_start_win=1
ro.mtk_perf_response_time=1

# Media
ro.vendor.mtk_flv_playback_support=1
media.stagefright.thumbnail.prefer_hw_codecs=true
vendor.mtk_thumbnail_optimization=true

# USB
ro.sys.usb.mtp.whql.enable=0
ro.sys.usb.storage.type=mtp
ro.sys.usb.charging.only=yes
ro.sys.usb.bicr=no

# Storage
persist.sys.fuse.passthrough.enable=true

# IPO
sys.ipo.pwrdncap=2
sys.ipo.disable=1

# iorapd
ro.iorapd.enable=false

# Kernel
ro.kernel.zio=38,108,105,16

# Memory
ro.config.per_app_memcg=true

# Misc
ro.vendor.mtk_omacp_support=1
ro.vendor.mtk_cta_set=1
ro.support_one_handed_mode=true
ro.mediatek.version.branch=alps-mp-s0.mssi1
persist.vendor.mdlog.flush_log_ratio=72340194296137244
ro.vendor.mtk_gwsd_support=1
persist.vendor.pms_removable=1
persist.vendor.vzw_device_type=0
qemu.hw.mainkeys=0

# WiFi
wifi.direct.interface=p2p0
wifi.interface=wlan0
ro.mediatek.wlan.wsc=1
ro.mediatek.wlan.p2p=1
mediatek.wlan.ctia=0
wifi.tethering.interface=ap0
persist.vendor.wfc.sys_wfc_support=1
ro.vendor.mtk_wifi_multi_sta_support=0

# Zygote
ro.zygote.preload.enable=0
zygote.critical_window.minute=10

# Disable Variable Refresh Rate (Lock to 120Hz)
ro.surface_flinger.min_graphics_refresh_rate=120
ro.surface_flinger.peak_refresh_rate=120
ro.surface_flinger.ignore_hdr_camera_refresh_rate=true

# Fix SurfaceFlinger scheduler uclamp errors
ro.surface_flinger.uclamp.screenshot=0
ro.surface_flinger.uclamp.bg=0

# HWUI cache tuning for Mali-G57
ro.hwui.texture_cache_size=72
ro.hwui.layer_cache_size=48
ro.hwui.r_buffer_cache_size=8
ro.hwui.path_cache_size=32
ro.hwui.gradient_cache_size=1
ro.hwui.drop_shadow_cache_size=6
ro.hwui.render_ahead=4
